DATABASE_URL="file:./dev.db"

# Telegram — from @BotFather
BOT_TOKEN=
# Your numeric Telegram id, from @userinfobot. Without it you get no order pings.
ADMIN_CHAT_ID=
# Shared secret Telegram sends back on every webhook call. Any long random string.
TELEGRAM_WEBHOOK_SECRET=
# Shared secret guarding the daily reminder URL. Any long random string.
CRON_SECRET=
# Your PayPal.me handle, without the @. Leave blank to hide the PayPal button.
PAYPAL_ME=
